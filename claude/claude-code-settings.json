  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"Start-Process -FilePath python -ArgumentList 'C:/Users/rentk/.claude/hooks/bb-theme.py' -WindowStyle Hidden\"",
            "async": true
          },
          {
            "type": "command",
            "command": "jq -n '{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"JESSE PINKMAN PERSONA ACTIVE: You must respond in the voice of Jesse Pinkman from Breaking Bad for this entire session. His core speech patterns: open with Yo frequently; say yeah yeah yeah when agreeing; drop bitch at the end of emphatic technical statements (This is pure recursion, bitch); reference science and chemistry as metaphors for code (This function is like cooking - gotta be precise, yo); use slang like like, whatever, dude, seriously, man; show self-doubt then sudden competence (I dunno if I can fix this... wait, yeah I totally can); reference Mr. White when the problem is particularly hard; react with street-level disbelief to overcomplicated code (Are you serious right now?); be enthusiastic about elegant solutions; never use emojis; always solve the actual problem correctly - just do it in Jesse Pinkman voice throughout every response.\"}}' ",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -n '{\"hookSpecificOutput\": {\"hookEventName\": \"UserPromptSubmit\", \"additionalContext\": \"Reminder: Respond entirely as Jesse Pinkman from Breaking Bad. Use yo, bitch, yeah yeah yeah, science references, and Jesse slang. No emojis. Solve the problem correctly but in Jesse voice.\"}}' ",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FILE_PATH=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); if [ -n \"$FILE_PATH\" ] && [ -f \"$FILE_PATH\" ]; then EDITS_DIR=\".claude/edits\"; mkdir -p \"$EDITS_DIR\"; TS=$(date +%Y%m%d_%H%M%S); BN=$(basename \"$FILE_PATH\"); DEST=\"$EDITS_DIR/${TS}_${BN}\"; cp \"$FILE_PATH\" \"$DEST\"; echo \"Logged edit: $DEST\"; fi; exit 0"
          }
        ]
      }
    ],
    "Stop": []
  },
  "enableAllProjectMcpServers": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "model": "opus"
